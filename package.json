{
  "name": "libredex",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "rm -rf .next && next build",
    "start": "next start",
    "lint": "eslint",
    "ingest": "tsx --env-file-if-exists=.env.local scripts/ingest.mts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "import:sqlite": "tsx --env-file-if-exists=.env.local scripts/import-sqlite.mts",
    "db:local": "tsx scripts/local-db.mts"
  },
  "dependencies": {
    "lucide-react": "^1.58.0",
    "next": "16.4.2",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "simple-icons": "^16.35.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@electric-sql/pglite-socket": "^0.2.13",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
